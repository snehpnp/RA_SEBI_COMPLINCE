<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Backend/API calls ignore karein (taki API request HTML return na kare)
  RewriteCond %{REQUEST_URI} ^/backend/ [NC]
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # Agar specific .html file maujood hai (e.g., /client -> /client.html), toh usko serve karein
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Agar upar kuch na mile, toh saari bachi hui requests index.html par bhej dein
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
