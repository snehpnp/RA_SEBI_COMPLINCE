<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API aur Backend ke routes ko ignore karein
  RewriteCond %{REQUEST_URI} ^/backend/ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # 2. Agar URL ke end mein slash (/) hai, toh usko remove karein (e.g. /admin/ -> /admin)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [L,R=301]

  # 3. Next.js ke .html pages ko serve karein (e.g. /admin -> admin.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. Agar file ya folder nahi milta, toh server seedha /login par redirect kar dega
  ErrorDocument 404 https://compliance.pnpuniverse.in/login
  
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /login [R=301,L]
</IfModule>
