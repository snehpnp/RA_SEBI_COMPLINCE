PORT=5000
JWT_SECRET=super-secret-jwt-key
REFRESH_SECRET=super-secret-refresh-key
DATABASE_URL="mongodb://root:password@127.0.0.1:27017/"
DB_NAME="sebi-compliance"

# SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mockuser
SMTP_PASSWORD=mockpassword

# Payment Gateways
RAZORPAY_KEY=rzp_test_mockkey
RAZORPAY_SECRET=rzp_test_mocksecret

# Digio KYC / eSign (Optional)
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_KYC_TEMPLATE_NAME=

# ==========================================
# Telegram Bot API Configuration
# ==========================================
# 1. Obtain Bot Token from @BotFather on Telegram (e.g. 7123456789:AAHxyz...)
TELEGRAM_BOT_TOKEN=

# 2. Telegram Group or Channel Chat ID (e.g. -1001234567890 for supergroups/channels)
TELEGRAM_CHAT_ID=

# 3. Optional: Direct invite link override (e.g. https://t.me/+AbCdEfGhIjK)
# If left empty, backend will automatically generate/export it via Telegram Bot API
TELEGRAM_INVITE_LINK=
